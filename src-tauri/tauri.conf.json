{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trim",
  "version": "0.6.4",
  "identifier": "com.xiaoxu.trim",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/backgrounds/**",
            "$APPDATA/fonts/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OEQyQzNGOTY0MzdGRTUKUldUbGYwT1dQeXlOaEx6MCtGTk9DOTltWVpFbzZZR2NjN1d6QS9iL0pNSlcrRGF1YkQ0T29VY1IK",
      "endpoints": [
        "https://gitee.com/xiaoxu1642/trim-tauri/raw/main/latest-gitee.json",
        "https://github.com/xiaoxu1642/trim-tauri/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}

